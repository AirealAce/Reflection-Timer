{
  "manifest_version": 3,
  "name": "Reflection Timer Focus Companion",
  "version": "1.0.0",
  "description": "Shares live browser target metadata with the installed Reflection Timer. No page content or browsing history is collected.",
  "key": "",
  "permissions": ["tabs", "tabGroups", "webNavigation", "nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "minimum_chrome_version": "105"
}
