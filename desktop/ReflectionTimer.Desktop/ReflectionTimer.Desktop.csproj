<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ReflectionTimer</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>../../favicon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <ProjectReference Include="../ReflectionTimer.Core/ReflectionTimer.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" GeneratePathProperty="true" />
    <PackageReference Include="NAudio" Version="3.0.1" />
    <PackageReference Include="System.Numerics.Tensors" Version="9.0.0" GeneratePathProperty="true" />
    <Content Include="../../popup.mp3" Link="popup.mp3" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Sounds/pokemon-obtained-item.mp3;../Sounds/pokemon-level-up.mp3;../Sounds/pokemon-key-item.mp3;../Sounds/pokemon-healed.mp3;../Sounds/pokemon-battle-trainer.mp3;../Sounds/pokemon-battle-champion.mp3;../Sounds/kirby-out-of-health.mp3" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Sounds/pokemon-rgby-trainer-battle.mp3;../Sounds/pokemon-rgby-wild-battle.mp3;../Sounds/pokemon-gsc-wild-johto-day.mp3;../Sounds/pokemon-gsc-wild-johto-night.mp3;../Sounds/pokemon-rgby-gym-leader.mp3;../Sounds/pokemon-dpp-regi-battle.mp3" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Sounds/pokemon-rgby-final-rival.mp3;../Sounds/pokemon-hgss-ho-oh.mp3;../Sounds/pokemon-gsc-wild-kanto.mp3;../Sounds/pokemon-gsc-gym-leader-kanto.mp3;../Sounds/pokemon-gsc-trainer-kanto.mp3;../Sounds/pokemon-dpp-dialga-palkia.mp3;../Sounds/pokemon-dpp-giratina.mp3;../Sounds/pokemon-dpp-lake-trio.mp3;../Sounds/pokemon-dpp-elite-four.mp3;../Sounds/pokemon-dpp-champion.mp3;../Sounds/pokemon-frlg-trainer.mp3;../Sounds/pokemon-frlg-wild.mp3;../Sounds/pokemon-frlg-gym-leader.mp3;../Sounds/pokemon-frlg-legendary.mp3;../Sounds/pokemon-frlg-mewtwo.mp3;../Sounds/pokemon-frlg-final-rival.mp3;../Sounds/pokemon-frlg-deoxys.mp3" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Sounds/AUDIO-NOTICES.txt" Link="AUDIO-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../google-sheets-script.gs" Link="google-sheets-script.gs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="../../google-sheets-script.gs" LogicalName="ReflectionTimer.Receiver.gs" />
    <Content Include="../THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgSystem_Numerics_Tensors)/THIRD-PARTY-NOTICES.TXT" Link="Tensors-THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_Web_WebView2)/LICENSE.txt" Link="WebView2-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_Web_WebView2)/NOTICE.txt" Link="WebView2-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Web/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../browser-companion/manifest.json;../../browser-companion/background.js;../../browser-companion/README.md" Link="browser-companion/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../START-HERE.html" Link="START-HERE.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="START-HERE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="README.md" Link="README.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="APP-PAGE-AUDIT.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RemoveUnusedWpfWebView" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup><Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" /></ItemGroup>
  </Target>
</Project>
